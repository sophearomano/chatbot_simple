# Copy this file to .env and fill it in. Never commit .env.

# Nothing here is required. Orin runs without any keys.

BOT_NAME=Orin

# Abuse limits.
MESSAGES_PER_HOUR=30
IP_MESSAGES_PER_HOUR=60

# Set this to make the bot private: new devices must enter this code.
ACCESS_CODE=

# Set to 1 only behind a proxy such as Render or Railway.
TRUST_PROXY=0

PORT=3000

# WhatsApp Cloud API. Leave empty to keep the channel switched off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
